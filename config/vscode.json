{
  "terminal.integrated.fontFamily": "'Cascadia Code', 'Cambria Math', 'Segoe UI Symbol', monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontWeightBold": "600",
  "terminal.integrated.drawBoldTextInBrightColors": false,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.customGlyphs": true,
  "terminal.integrated.rescaleOverlappingGlyphs": true,
  "terminal.integrated.enableImages": true,
  "terminal.integrated.scrollback": 20000,
  "markdown.math.enabled": true,
  "workbench.editorAssociations": {
    "**/.claude/typeset/*.md": "vscode.markdown.preview.editor"
  },
  "workbench.colorCustomizations": {
    "terminal.background": "#262624",
    "terminal.foreground": "#E8E6DC",
    "terminalCursor.foreground": "#D97757",
    "terminalCursor.background": "#262624",
    "terminal.selectionBackground": "#D9775740",
    "terminal.border": "#3A3833",
    "terminal.tab.activeBorder": "#D97757",
    "terminal.ansiBlack": "#1F1E1D",
    "terminal.ansiRed": "#E07A6F",
    "terminal.ansiGreen": "#8DB580",
    "terminal.ansiYellow": "#E3B261",
    "terminal.ansiBlue": "#7DA2CE",
    "terminal.ansiMagenta": "#C99BC2",
    "terminal.ansiCyan": "#7FB8B0",
    "terminal.ansiWhite": "#D8D5CA",
    "terminal.ansiBrightBlack": "#6B675F",
    "terminal.ansiBrightRed": "#F0958A",
    "terminal.ansiBrightGreen": "#A6C99A",
    "terminal.ansiBrightYellow": "#F0C67E",
    "terminal.ansiBrightBlue": "#9AB9DE",
    "terminal.ansiBrightMagenta": "#DDB2D6",
    "terminal.ansiBrightCyan": "#9ACDC5",
    "terminal.ansiBrightWhite": "#F5F3EC"
  }
}
